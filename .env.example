# Copy this file to .env and fill in real values. Never commit .env.

PORT=8080

# PostgreSQL connection string (e.g. from Neon). Accounts, sign-ins and linked
# PCs are stored here; tables are created automatically on first start.
# Passwords and secrets are only ever stored hashed.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Neon (*.neon.tech) is reached over WebSocket on port 443 automatically,
# because many networks block PostgreSQL's port 5432. Override if needed:
# DB_DRIVER=pg      # force the standard driver (port 5432)
# DB_DRIVER=neon    # force Neon's WebSocket driver

# Only used when DATABASE_URL is empty: a local JSON file for quick testing.
# DATA_FILE=./data/store.json

# Anyone can create an account while this is true. Once your own account
# exists, set it to false if this server is only for you.
ALLOW_REGISTRATION=true

# Web app origins allowed to call the API, comma-separated, or * for any.
# e.g. CORS_ORIGINS=https://relay.example.com,http://localhost:3000
CORS_ORIGINS=*

# Set to true when running behind a proxy (Render, Fly, Railway, nginx) so
# login rate limits see each visitor's real IP instead of the proxy's.
TRUST_PROXY=false
